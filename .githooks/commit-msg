#!/bin/sh
# Conventional Commits 강제 (의존성 0). 우회: git commit --no-verify
# 활성화(클론마다 1회): git config core.hooksPath .githooks

header=$(head -1 "$1")

# merge/revert 자동생성 커밋은 통과
echo "$header" | grep -qE '^(Merge|Revert)' && exit 0

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'
if ! echo "$header" | grep -qE "$pattern"; then
  echo "✗ 커밋 메시지 형식 위반"
  echo "  형식: <type>(<scope>): <subject>"
  echo "  type: feat fix docs style refactor perf test build ci chore revert"
  echo "  예)  feat(auth): JWT 로그인 필터 추가"
  echo "  받음: $header"
  exit 1
fi
