# 브라우저가 API를 호출하는 경로입니다. 기본값(/api/proxy)을 쓰면 next.config.ts의 리버스
# 프록시를 거치므로, 특별한 이유가 없으면 이 줄은 그대로 주석 처리해두면 됩니다.
# NEXT_PUBLIC_API_BASE_URL=/api/proxy

# 리버스 프록시가 실제로 요청을 대신 전달할 백엔드 주소입니다. NEXT_PUBLIC_이 안 붙어서
# 브라우저에는 노출되지 않고, next.config.ts의 rewrites에서만 씁니다.
BACKEND_API_URL=http://localhost:8080/api/v1

# MSW 목 서버 스위치.
# 개발 중에는 기본으로 켜지고, 프로덕션 빌드에서는 항상 꺼집니다.
# 실제 백엔드에 붙여볼 때만 주석을 풀어 disabled로 둡니다.
# NEXT_PUBLIC_API_MOCKING=disabled

# 발표 자료를 요약할 때 쓰는 OpenRouter 키입니다(키 값은 노션 참조).
# 소감 요약과 리포트 본문은 백엔드가 만듭니다. 프론트가 모델을 부르는 곳은
# app/api/deck-summary/route.ts 하나뿐입니다.
#
# NEXT_PUBLIC_ 접두사가 없어야 합니다. 강연자 화면은 로그인이 없는 공개 페이지라,
# 번들에 실리면 주소를 아는 누구나 꺼내 우리 크레딧을 씁니다.
OPENROUTER_API_KEY = 
OPENROUTER_MODEL=qwen/qwen3.7-flash